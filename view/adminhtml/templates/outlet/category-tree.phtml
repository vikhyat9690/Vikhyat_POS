<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Magento Category Tree</title>
    <style>
        body {
            font-family: 'Open Sans', Arial, sans-serif;
            margin: 20px;
            background-color: #f8f8f8;
        }

        .category-tree-container {
            background: white;
            border: 1px solid #ddd;
            border-radius: 4px;
            padding: 15px;
            max-width: 500px;
        }

        .tree-header {
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 1px solid #eee;
        }

        .tree-actions {
            font-size: 13px;
        }

        .tree-actions a {
            color: #007bdb;
            text-decoration: none;
            margin-right: 10px;
        }

        .tree-actions a:hover {
            text-decoration: underline;
        }

        .category-tree {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .category-item {
            margin: 0;
            padding: 0;
        }

        .category-content {
            display: flex;
            align-items: center;
            padding: 3px 0;
            line-height: 20px;
            font-size: 13px;
            color: #333;
        }

        .tree-connector {
            width: 20px;
            height: 20px;
            margin-right: 2px;
            position: relative;
            flex-shrink: 0;
        }

        .tree-connector::before {
            content: '';
            position: absolute;
            left: 8px;
            top: -10px;
            bottom: 10px;
            width: 1px;
            background: #ccc;
        }

        .tree-connector::after {
            content: '';
            position: absolute;
            left: 8px;
            top: 10px;
            width: 12px;
            height: 1px;
            background: #ccc;
        }

        .category-item:last-child > .category-content > .tree-connector::before {
            bottom: 50%;
        }

        .expand-toggle {
            width: 16px;
            height: 16px;
            margin-right: 4px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            color: #666;
            user-select: none;
            flex-shrink: 0;
        }

        .expand-toggle:hover {
            background-color: #f0f0f0;
        }

        .expand-toggle.expandable::before {
            content: '+';
            font-weight: bold;
        }

        .expand-toggle.expanded::before {
            content: '−';
            font-weight: bold;
        }

        .category-icon {
            width: 16px;
            height: 16px;
            margin-right: 6px;
            background-image: url('data:image/png;base64,');
            background-size: contain;
            flex-shrink: 0;
        }

        .category-checkbox {
            margin-right: 6px;
            flex-shrink: 0;
        }

        .category-label {
            cursor: pointer;
            flex-grow: 1;
        }

        .category-label:hover {
            color: #007bdb;
        }

        .category-count {
            margin-left: 4px;
            color: #666;
        }

        .category-children {
            list-style: none;
            padding: 0;
            margin: 0;
            margin-left: 20px;
            display: none;
        }

        .category-children.expanded {
            display: block;
        }

        .root-category > .category-content > .tree-connector {
            display: none;
        }

        .disabled {
            color: #999;
        }

        .disabled .category-label {
            cursor: default;
        }

        .disabled .category-label:hover {
            color: #999;
        }
    </style>
</head>
<body>
