    <script>
        class CategoryTree {
            constructor(containerId) {
                this.container = document.getElementById(containerId);
                this.init();
            }

            init() {
                this.attachEventListeners();
                this.initializeExpandToggleStates();
            }

            attachEventListeners() {
                // Expand/collapse toggle functionality
                this.container.addEventListener('click', (e) => {
                    if (e.target.classList.contains('expand-toggle')) {
                        this.toggleCategory(e.target);
                    }
                });

                // Checkbox change events
                this.container.addEventListener('change', (e) => {
                    if (e.target.classList.contains('category-checkbox')) {
                        this.handleCheckboxChange(e.target);
                    }
                });

                // Collapse All functionality
                document.getElementById('collapseAll').addEventListener('click', (e) => {
                    e.preventDefault();
                    this.collapseAll();
                });

                // Expand All functionality
                document.getElementById('expandAll').addEventListener('click', (e) => {
                    e.preventDefault();
                    this.expandAll();
                });
            }

            initializeExpandToggleStates() {
                const toggles = this.container.querySelectorAll('.expand-toggle');
                toggles.forEach(toggle => {
                    const categoryId = toggle.dataset.categoryId;
                    const children = document.getElementById(`children-${categoryId}`);
                    
                    if (children && children.children.length > 0) {
                        toggle.classList.add('expandable');
                    }
                });
            }

            toggleCategory(toggle) {
                if (!toggle.classList.contains('expandable')) return;
                
                const categoryId = toggle.dataset.categoryId;
                const children = document.getElementById(`children-${categoryId}`);
                
                if (!children) return;

                if (children.classList.contains('expanded')) {
                    this.collapseCategory(toggle, children);
                } else {
                    this.expandCategory(toggle, children);
                }
            }

            expandCategory(toggle, children) {
                toggle.classList.add('expanded');
                children.classList.add('expanded');
                children.style.display = 'block';
            }

            collapseCategory(toggle, children) {
                toggle.classList.remove('expanded');
                children.classList.remove('expanded');
                children.style.display = 'none';
                
                // Also collapse any nested expanded categories
                const nestedExpanded = children.querySelectorAll('.expand-toggle.expanded');
                nestedExpanded.forEach(nestedToggle => {
                    const nestedCategoryId = nestedToggle.dataset.categoryId;
                    const nestedChildren = document.getElementById(`children-${nestedCategoryId}`);
                    if (nestedChildren) {
                        this.collapseCategory(nestedToggle, nestedChildren);
                    }
                });
            }

            expandAll() {
                const expandableToggles = this.container.querySelectorAll('.expand-toggle.expandable:not(.expanded)');
                expandableToggles.forEach(toggle => {
                    const categoryId = toggle.dataset.categoryId;
                    const children = document.getElementById(`children-${categoryId}`);
                    if (children) {
                        this.expandCategory(toggle, children);
                    }
                });
            }

            collapseAll() {
                const expandedToggles = this.container.querySelectorAll('.expand-toggle.expanded');
                expandedToggles.forEach(toggle => {
                    const categoryId = toggle.dataset.categoryId;
                    const children = document.getElementById(`children-${categoryId}`);
                    if (children) {
                        this.collapseCategory(toggle, children);
                    }
                });
            }

            handleCheckboxChange(checkbox) {
                const categoryId = checkbox.value;
                const isChecked = checkbox.checked;
                
                // Check/uncheck child categories
                this.updateChildCategories(categoryId, isChecked);
                
                // Update parent category state
                this.updateParentCategories(checkbox);
                
                // Log selected categories (for development)
                this.logSelectedCategories();
            }

            updateChildCategories(categoryId, isChecked) {
                const children = document.getElementById(`children-${categoryId}`);
                if (!children) return;
                
                const childCheckboxes = children.querySelectorAll('.category-checkbox');
                childCheckboxes.forEach(childCheckbox => {
                    if (!childCheckbox.disabled) {
                        childCheckbox.checked = isChecked;
                        childCheckbox.indeterminate = false;
                        
                        // Recursively update nested children
                        this.updateChildCategories(childCheckbox.value, isChecked);
                    }
                });
            }

            updateParentCategories(checkbox) {
                const categoryItem = checkbox.closest('.category-item');
                const parentChildren = categoryItem.parentElement;
                
                if (!parentChildren.classList.contains('category-children')) return;
                
                const parentCategoryId = parentChildren.id.replace('children-', '');
                const parentCheckbox = document.getElementById(`cat-${parentCategoryId}`);
                
                if (!parentCheckbox || parentCheckbox.disabled) return;
                
                const siblingCheckboxes = parentChildren.querySelectorAll(':scope > .category-item > .category-content > .category-checkbox');
                const checkedSiblings = Array.from(siblingCheckboxes).filter(cb => cb.checked && !cb.disabled);
                const indeterminateSiblings = Array.from(siblingCheckboxes).filter(cb => cb.indeterminate && !cb.disabled);
                const enabledSiblings = Array.from(siblingCheckboxes).filter(cb => !cb.disabled);
                
                if (checkedSiblings.length === enabledSiblings.length) {
                    parentCheckbox.checked = true;
                    parentCheckbox.indeterminate = false;
                } else if (checkedSiblings.length > 0 || indeterminateSiblings.length > 0) {
                    parentCheckbox.checked = false;
                    parentCheckbox.indeterminate = true;
                } else {
                    parentCheckbox.checked = false;
                    parentCheckbox.indeterminate = false;
                }
                
                // Recursively update parent's parent
                this.updateParentCategories(parentCheckbox);
            }

            logSelectedCategories() {
                const selectedCategories = [];
                const checkboxes = this.container.querySelectorAll('.category-checkbox:checked');
                
                checkboxes.forEach(checkbox => {
                    const label = checkbox.nextElementSibling;
                    selectedCategories.push({
                        id: checkbox.value,
                        name: label.textContent.trim()
                    });
                });
                
                console.log('Selected Categories:', selectedCategories);
            }

            getSelectedCategoryIds() {
                const checkboxes = this.container.querySelectorAll('.category-checkbox:checked');
                return Array.from(checkboxes).map(cb => cb.value);
            }

            selectCategories(categoryIds) {
                // Clear all selections first
                const allCheckboxes = this.container.querySelectorAll('.category-checkbox');
                allCheckboxes.forEach(cb => {
                    cb.checked = false;
                    cb.indeterminate = false;
                });
                
                // Select specified categories
                categoryIds.forEach(id => {
                    const checkbox = document.getElementById(`cat-${id}`);
                    if (checkbox && !checkbox.disabled) {
                        checkbox.checked = true;
                        this.updateParentCategories(checkbox);
                    }
                });
            }
        }

        // Initialize the category tree
        const categoryTree = new CategoryTree('categoryTree');

        // Example usage:
        // categoryTree.selectCategories(['3', '31', '32']); // Pre-select some categories
        // const selected = categoryTree.getSelectedCategoryIds(); // Get selected category IDs
    </script>
</body>
</html>